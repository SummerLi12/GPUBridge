#version 450
layout(local_size_x = 1) in;

layout(set = 0, binding = 0) readonly buffer BufA { float a[]; };
layout(set = 0, binding = 1) writeonly buffer BufResult { float result[]; };

layout(push_constant) uniform PushConstants {
    int n;
} pc;

void main() {
    float sum = 0.0;
    for (int i = 0; i < pc.n; i++) {
        sum += a[i];
    }
    result[0] = sum;
}
